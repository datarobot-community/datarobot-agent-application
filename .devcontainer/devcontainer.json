{
	"name": "Application Framework Studio Devcontainer",
	"build": {
		"dockerfile": "Dockerfile"
	},
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {},
        "ghcr.io/eitsupi/devcontainer-features/go-task:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/pulumi.com:1": {}
    },
    "onCreateCommand": "uv tool install pre-commit && pulumi plugin install resource datarobot ${PULUMI_DATAROBOT_PLUGIN_VERSION} --server https://github.com/datarobot-community/pulumi-datarobot/releases/download/${PULUMI_DATAROBOT_PLUGIN_VERSION}/ && pulumi login --local",
    "customizations": {
        "jetbrains": {
            "plugins": [
                "lechuck.intellij-plugin.task"
            ],
            "backend": "pycharm"
		},
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "eamodio.gitlens",
                "task.vscode-tasks",
                "ms-python.python"
            ]
        }
    },
    "forwardPorts": [51164, 8083, 8080, 8842, 5173, 9000],
    "mounts": [
        "type=volume,source=agentic-devcontainer-pulumi,target=/home/vscode/.pulumi",
        "type=volume,source=agentic-devcontainer-cache,target=/home/vscode/.cache",
        "type=volume,source=agentic-devcontainer-config,target=/home/vscode/.config"
    ]
}
