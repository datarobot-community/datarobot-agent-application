# DataRobot source ignore patterns (gitignore syntax)
#
# .datarobot.yaml is never uploaded (hardcoded system exclude, not listed
# here). Edit this file to add or remove rules.

# Python artifacts
__pycache__
*.pyc
*.pyo
.venv
venv
*.egg-info

# Environment / secrets
.env
.env.*

# Build artifacts
dist
build
node_modules

# IDE / OS
.DS_Store
.idea
.vscode

# Tool caches
.mypy_cache
.pytest_cache
.ruff_cache

# Terraform: source.dir can be the directory holding the configuration that
# declares it. State files, the provider cache and *.tfvars are system
# excludes -- they carry credentials, so deleting a line here cannot bring
# them back. These are the rest: useless in an image, but yours to upload.
.terraform.lock.hcl
.terraform.tfstate.lock.info

# Conflict copies (auto-generated by sync — DO NOT REMOVE)
*.LOCAL.*
